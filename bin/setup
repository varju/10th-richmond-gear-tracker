#!/usr/bin/env bash
# Sets up a working development environment on a clean machine (NFR-MAINT-03).
set -euo pipefail
cd "$(dirname "$0")/.."

if ! command -v uv >/dev/null 2>&1; then
  echo "Installing uv..."
  curl -LsSf https://astral.sh/uv/install.sh | sh
  export PATH="$HOME/.local/bin:$PATH"
fi

# uv fetches a standalone interpreter, so this works on a distro that has not
# packaged 3.14 yet (NFR-MAINT-03).
echo "Ensuring Python 3.14..."
uv python install 3.14

echo "Syncing dependencies..."
uv sync

if command -v npm >/dev/null 2>&1; then
  echo "Installing client dependencies..."
  (cd client && npm ci)
else
  echo "npm not found: skipping the client. Install Node 26 or newer to work on it."
fi

echo "Installing git hooks..."
uv run pre-commit install

echo
echo "Ready. Try: make check"
